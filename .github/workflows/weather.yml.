name: weather
on:
  schedule:
    - cron: "*/30 * * * *"
  workflow_dispatch:
permissions:
  contents: write
jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Fetch weather
        run: |
          curl -sf "https://api.open-meteo.com/v1/forecast?latitude=49.5&longitude=23.2&current=temperature_2m,weather_code&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=Europe%2FKyiv&forecast_days=4" -o weather.json
      - name: Commit
        run: |
          git config user.name "weather-bot"
          git config user.email "bot@users.noreply.github.com"
          git add weather.json
          git commit -m "update weather" || exit 0
          git push
